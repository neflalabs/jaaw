#!/usr/bin/env bash
#
# jaaw - Jembatan Awakutu Android Wireless (Android Debug Bridge Wireless Companion)
# Highly optimized for Fedora, Ubuntu, Arch, and Android 11-16.
#
# Features:
# - Active Wi-Fi SSID detection & display (nmcli / iw)
# - Sub-100ms event-driven mDNS discovery via Avahi streaming
# - Automatic device model & Android 16 detection from mDNS TXT records
# - Auto-connect immediately following pairing
# - Optional scrcpy screen mirroring integration (--screen / -s)
# - Desktop notifications via notify-send
# - Smart device history cache in ~/.config/jaaw/
# - 1-Click USB-to-Wireless switch (adb tcpip 5555)
# - Clean Ctrl+C / SIGINT signal cancellation
# - Smooth terminal spinner and graphics protocol support (Kitty, iTerm2, ANSI)

set -euo pipefail

# Ensure running on Linux
if [ "$(uname)" != "Linux" ]; then
    echo "Error: jaaw is designed specifically for Linux." >&2
    exit 1
fi

VERSION="v2026.09.09"
TIMEOUT=60
LAUNCH_SCRCPY=false
SCRCPY_BITRATE=""
SCRCPY_SCREEN_OFF=false
SCRCPY_CUSTOM_ARGS=()
NAME=""
CODE=""
PAYLOAD=""
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/jaaw"
HISTORY_FILE="${HISTORY_FILE:-$CONFIG_DIR/devices.tsv}"
ALIAS_FILE="${ALIAS_FILE:-$CONFIG_DIR/aliases.tsv}"

# Colors and styling
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
CYAN='\033[36m'
RESET='\033[0m'

# Initialize config directory
mkdir -p "$CONFIG_DIR" 2>/dev/null || true

# Global signal handler for clean Ctrl+C cancellation
on_interrupt() {
    printf '\033[?25h\n' 2>/dev/null || true
    # Kill any active child/background processes
    jobs -p 2>/dev/null | xargs -r kill 2>/dev/null || true
    pkill -P $$ 2>/dev/null || true
    echo -e "\n${YELLOW}[!] Dibatalkan (Ctrl+C).${RESET}"
    exit 130
}
trap on_interrupt INT TERM

die() {
    printf '\033[?25h' 2>/dev/null || true
    echo -e "\n${RED}${BOLD}[!] Error:${RESET} $*" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}${BOLD}[!] Perhatian:${RESET} $*" >&2
}

info() {
    echo -e "${BLUE}${BOLD}[i]${RESET} $*"
}

success() {
    echo -e "${GREEN}${BOLD}[✓]${RESET} $*"
}

notify_desktop() {
    local title="$1"
    local msg="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "jaaw" -i "phone" "$title" "$msg" 2>/dev/null || true
    fi
}

# The platform's usual package manager on Linux
pkg_manager() {
    local m
    for m in dnf apt pacman zypper apk; do
        if command -v "$m" >/dev/null 2>&1; then echo "$m"; return; fi
    done
}

install_hint() {
    local mgr
    mgr=$(pkg_manager)
    case "$1:$mgr" in
        adb:apt)                                   echo "sudo apt install adb" ;;
        adb:dnf|adb:zypper)                        echo "sudo $mgr install android-tools" ;;
        adb:pacman)                                echo "sudo pacman -S android-tools" ;;
        adb:apk)                                   echo "sudo apk add android-tools" ;;
        adb:*)                                     echo "Install Android platform-tools / adb." ;;
        qrencode:apt|qrencode:dnf|qrencode:zypper) echo "sudo $mgr install qrencode" ;;
        qrencode:pacman)                           echo "sudo pacman -S qrencode" ;;
        qrencode:apk)                              echo "sudo apk add libqrencode-tools" ;;
        qrencode:*)                                echo "Install qrencode." ;;
        avahi-browse:dnf|avahi-browse:zypper)      echo "sudo $mgr install avahi-tools" ;;
        avahi-browse:apt)                          echo "sudo apt install avahi-utils" ;;
        avahi-browse:pacman)                       echo "sudo pacman -S avahi" ;;
        avahi-browse:apk)                          echo "sudo apk add avahi" ;;
        avahi-browse:*)                            echo "Install avahi-tools / avahi-utils." ;;
        scrcpy:dnf|scrcpy:zypper)                  echo "sudo $mgr install scrcpy" ;;
        scrcpy:apt)                                echo "sudo apt install scrcpy" ;;
        scrcpy:pacman)                             echo "sudo pacman -S scrcpy" ;;
        scrcpy:*)                                  echo "Install scrcpy." ;;
    esac
}

require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        local hint
        hint=$(install_hint "$1")
        die "'$1' tidak ditemukan. Jalankan: ${BOLD}${hint}${RESET}"
    fi
}

check_dependencies() {
    require adb
    require qrencode

    if ! adb mdns check >/dev/null 2>&1 && ! command -v avahi-browse >/dev/null 2>&1; then
        warn "Distro ADB kamu tidak memiliki built-in mDNS dan 'avahi-browse' belum terinstall."
        local hint
        hint=$(install_hint "avahi-browse")
        echo -e "    Disarankan install avahi: ${BOLD}${hint}${RESET}\n"
    fi
}

# Detect connected Wi-Fi SSID
get_wifi_ssid() {
    local ssid=""
    # 1. Try nmcli (NetworkManager standard on Fedora/Ubuntu/Arch)
    if command -v nmcli >/dev/null 2>&1; then
        ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}' || true)
    fi

    # 2. Try iw fallback
    if [ -z "$ssid" ] && command -v iw >/dev/null 2>&1; then
        local iface
        iface=$(ip route show default 2>/dev/null | awk '/default/{print $5; exit}')
        if [ -n "$iface" ]; then
            ssid=$(iw dev "$iface" link 2>/dev/null | awk -F': ' '/SSID:/{print $2; exit}' || true)
        fi
    fi

    echo "$ssid"
}


# Safe adb connect helper (validates output because adb connect may return exit code 0 on failure)
safe_adb_connect() {
    local target="$1"
    local output
    output=$(adb connect "$target" 2>&1)
    echo "$output"
    if [[ "$output" == *"connected to "* ]] || [[ "$output" == *"already connected to "* ]]; then
        return 0
    fi
    return 1
}

# Launch scrcpy if requested with smooth wireless optimizations
maybe_launch_scrcpy() {
    local serial="$1"
    if [ "$LAUNCH_SCRCPY" = true ]; then
        if command -v scrcpy >/dev/null 2>&1; then
            echo ""
            local cmd_args=("-s" "$serial")

            # Default smooth wireless tuning for stable low-latency streaming:
            # - video-buffer=50 (jitter buffer to prevent micro-stutters)
            # - audio-buffer=50 (smooth audio streaming)
            # - max-size=1280 (limit resolution to prevent Wi-Fi bandwidth exhaustion)
            # - max-fps=60 (cap 60fps to prevent 90/120Hz saturation)
            cmd_args+=(
                "--video-buffer=50"
                "--audio-buffer=50"
                "--max-size=1280"
                "--max-fps=60"
            )

            # Bitrate configuration (default 6M for wireless if not specified)
            if [ -n "$SCRCPY_BITRATE" ]; then
                cmd_args+=("--video-bit-rate=$SCRCPY_BITRATE")
            else
                cmd_args+=("--video-bit-rate=6M")
            fi

            # Screen-off shortcut
            if [ "$SCRCPY_SCREEN_OFF" = true ]; then
                cmd_args+=("--turn-screen-off" "--stay-awake")
            fi

            # SCRCPY_ARGS environment variable support
            if [ -n "${SCRCPY_ARGS:-}" ]; then
                eval "local env_opts=($SCRCPY_ARGS)"
                cmd_args+=("${env_opts[@]}")
            fi

            # Passthrough custom args (--scrcpy-args or trailing --)
            if [ ${#SCRCPY_CUSTOM_ARGS[@]} -gt 0 ]; then
                cmd_args+=("${SCRCPY_CUSTOM_ARGS[@]}")
            fi

            info "Membuka screen mirroring (${BOLD}scrcpy ${cmd_args[*]}${RESET})..."
            scrcpy "${cmd_args[@]}" >/dev/null 2>&1 &
        else
            warn "scrcpy belum terinstall. Jalankan: ${BOLD}$(install_hint scrcpy)${RESET}"
        fi
    fi
}

# Convert Android API Level (e.g. 36.0) to friendly Android Version
api_to_version() {
    local raw="${1:-}"
    local api="${raw%%.*}"
    case "$api" in
        36) echo "Android 16" ;;
        35) echo "Android 15" ;;
        34) echo "Android 14" ;;
        33) echo "Android 13" ;;
        31|32) echo "Android 12" ;;
        30) echo "Android 11" ;;
        *)  [ -n "$api" ] && echo "Android API $api" || echo "Android" ;;
    esac
}

# Parse TXT records from mDNS (name and api)
parse_txt_record() {
    local txt="$1"
    local model="" api=""
    if [[ "$txt" =~ name=\"?([^\"[:space:]]+) ]]; then
        model="${BASH_REMATCH[1]}"
    fi
    if [[ "$txt" =~ api=\"?([^\"[:space:]]+) ]]; then
        api="${BASH_REMATCH[1]}"
    fi
    echo "$model|$api"
}

# Save device to history
save_device_history() {
    local ip="$1"
    local port="$2"
    local model="${3:-Unknown}"
    local os_ver="${4:-Android}"
    local s_name="${5:-}"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    local tmp_hist
    tmp_hist=$(mktemp "${TMPDIR:-/tmp}/jaaw-hist.XXXXXX")
    if [ -f "$HISTORY_FILE" ]; then
        # Remove existing entry for same IP to avoid duplicates
        awk -F'\t' -v target_ip="$ip" '$2 != target_ip' "$HISTORY_FILE" > "$tmp_hist" 2>/dev/null || true
    fi
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$timestamp" "$ip" "$port" "$model" "$os_ver" "$s_name" >> "$tmp_hist"
    mv "$tmp_hist" "$HISTORY_FILE"

    # Also update last seen IP:Port in aliases.tsv if matching target or service name
    if [ -f "$ALIAS_FILE" ]; then
        local tmp_alias
        tmp_alias=$(mktemp "${TMPDIR:-/tmp}/jaaw-alias-sync.XXXXXX")
        awk -F'\t' -v s="$s_name" -v ip_port="$ip:$port" -v ip_addr="$ip" -v t="$timestamp" '
        BEGIN { OFS="\t" }
        NR==1 { print; next }
        $1 ~ /^#/ { print; next }
        {
            if ((s != "" && $2 == s) || (s != "" && index($2, s) > 0) || (index($2, ip_addr) > 0)) {
                $4 = ip_port
                $5 = t
            }
            print
        }' "$ALIAS_FILE" > "$tmp_alias" 2>/dev/null && mv "$tmp_alias" "$ALIAS_FILE" || rm -f "$tmp_alias" 2>/dev/null
    fi
}

# Best-effort IPv4 prefix length on Linux
wifi_prefixlen() {
    local iface
    iface=$(ip route show default 2>/dev/null | awk '/default/{print $5; exit}')
    [ -n "$iface" ] || return 0
    ip -o -f inet addr show dev "$iface" 2>/dev/null \
        | awk '{print $4}' | awk -F/ 'NF>1 {print $2; exit}'
}

network_warning() {
    local plen
    plen=$(wifi_prefixlen)
    [ -n "$plen" ] || return 0
    if [ "$plen" -le 22 ]; then
        warn "Jaringan ini terdeteksi sebagai subnet publik/besar (/$plen)."
        echo -e "    Wi-Fi publik sering mengaktifkan ${BOLD}AP Isolation${RESET} yang memblokir mDNS."
        echo -e "    Jika pairing tidak terdeteksi, gunakan Hotspot HP / Wi-Fi lokal.\n"
    fi
}

# Render QR using Kitty graphics protocol
render_inline_kitty() {
    local b64 pos len chunk m first
    b64=$(qrencode -m 2 -s 8 -o - -t PNG "$PAYLOAD" 2>/dev/null | base64 | tr -d '\n') || return 1
    pos=0; len=${#b64}; first=1
    while [ "$pos" -lt "$len" ]; do
        chunk=${b64:pos:4096}
        pos=$((pos + 4096))
        m=1; if [ "$pos" -ge "$len" ]; then m=0; fi
        if [ "$first" -eq 1 ]; then
            printf '\033_Gf=100,a=T,m=%d;%s\033\\' "$m" "$chunk"
            first=0
        else
            printf '\033_Gm=%d;%s\033\\' "$m" "$chunk"
        fi
    done
    printf '\n'
}

# Render QR using iTerm2 protocol
render_inline_iterm2() {
    local b64
    b64=$(qrencode -m 2 -s 8 -o - -t PNG "$PAYLOAD" 2>/dev/null | base64 | tr -d '\n') || return 1
    printf '\033]1337;File=inline=1;preserveAspectRatio=1:%s\a\n' "$b64"
}

term_query() {
    [ -t 1 ] && [ -r /dev/tty ] || return 1
    local old resp
    old=$(stty -g </dev/tty 2>/dev/null) || return 1
    stty -echo -icanon </dev/tty 2>/dev/null || { stty "$old" </dev/tty 2>/dev/null; return 1; }
    printf '%s\033[c' "$1" >/dev/tty
    # shellcheck disable=SC2034
    IFS= read -rs -t 1 -d 'c' resp </dev/tty || true
    stty "$old" </dev/tty 2>/dev/null
    printf '%s' "$resp"
}

supports_kitty_graphics() {
    local r
    r=$(term_query $'\033_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\033\\') || return 1
    [[ "$r" == *"_Gi=31;OK"* ]]
}

supports_iterm2_image() {
    local r
    r=$(term_query $'\033[>q') || return 1
    [[ "$r" == *"iTerm2"* || "$r" == *"WezTerm"* ]]
}

render_qr() {
    if supports_kitty_graphics && render_inline_kitty; then return 0; fi
    if supports_iterm2_image && render_inline_iterm2; then return 0; fi
    qrencode -m 2 -t ANSIUTF8 "$PAYLOAD"
}

# Real-time event-driven mDNS discovery with sub-100ms latency and spinner UI
# Output variables: TARGET_ADDR, TARGET_MODEL, TARGET_ANDROID, TARGET_SERVICE
stream_discover_mdns() {
    local service_type="$1"
    local target_name="${2:-}"
    local target_ip="${3:-}"
    local timeout_sec="${4:-60}"
    local prompt_msg="${5:-Menunggu deteksi perangkat...}"

    TARGET_ADDR=""
    TARGET_MODEL=""
    TARGET_ANDROID=""
    TARGET_SERVICE=""

    local spin_chars=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local spin_idx=0
    local start_time
    start_time=$(date +%s)

    # 1. Event streaming using Avahi (Linux/Fedora)
    if command -v avahi-browse >/dev/null 2>&1; then
        local fifo="" browse_pid=""
        fifo=$(mktemp -u "${TMPDIR:-/tmp}/jaaw-fifo.XXXXXX")
        mkfifo "$fifo"
        exec 3<>"$fifo"

        avahi-browse -r -p "$service_type" >&3 2>/dev/null &
        browse_pid=$!

        printf '\033[?25l' # Hide cursor

        cleanup_browse() {
            [ -n "$browse_pid" ] && kill "$browse_pid" 2>/dev/null || true
            [ -n "$browse_pid" ] && wait "$browse_pid" 2>/dev/null || true
            exec 3>&- 2>/dev/null || true
            [ -n "$fifo" ] && rm -f "$fifo" 2>/dev/null || true
            printf '\033[?25h' 2>/dev/null || true
        }

        while true; do
            local now
            now=$(date +%s)
            local elapsed=$((now - start_time))
            if [ "$elapsed" -ge "$timeout_sec" ]; then
                break
            fi

            # Non-blocking read with 0.1s timeout
            if read -r -t 0.1 -u 3 line; then
                if [[ "$line" == "=;"* ]]; then
                    local status iface proto name type domain host ip port txt
                    # shellcheck disable=SC2034
                    IFS=';' read -r status iface proto name type domain host ip port txt <<< "$line"
                    if [ "$proto" = "IPv4" ] && [ -n "$ip" ] && [ -n "$port" ]; then
                        if [ -n "$target_name" ] && [ "$name" != "$target_name" ]; then
                            continue
                        fi
                        if [ -n "$target_ip" ] && [ "$ip" != "$target_ip" ]; then
                            continue
                        fi

                        TARGET_ADDR="$ip:$port"
                        [ -n "$name" ] && [ -n "$type" ] && TARGET_SERVICE="$name.$type"
                        local parsed
                        parsed=$(parse_txt_record "$txt")
                        TARGET_MODEL="${parsed%%|*}"
                        local raw_api="${parsed##*|}"
                        TARGET_ANDROID=$(api_to_version "$raw_api")
                        break
                    fi
                fi
            fi

            local char="${spin_chars[$spin_idx]}"
            spin_idx=$(( (spin_idx + 1) % ${#spin_chars[@]} ))
            local remaining=$((timeout_sec - elapsed))
            printf "\r  ${CYAN}%s${RESET} %s ${DIM}(%ds)${RESET}  " "$char" "$prompt_msg" "$remaining"
        done

        cleanup_browse
        printf "\r\033[K" # Clear spinner line

        [ -n "$TARGET_ADDR" ] && return 0
    fi

    # 2. Fallback to native adb mdns polling
    if adb mdns check >/dev/null 2>&1; then
        for _ in $(seq 1 "$timeout_sec"); do
            local res
            res=$(adb mdns services 2>/dev/null | awk -F'\t' -v svc="$service_type" -v name="$target_name" '
                $2 ~ svc {
                    if (name == "" || index($1, name) > 0) {
                        print $3 "|" $1 "." $2;
                        exit;
                    }
                }
            ')
            if [ -n "$res" ]; then
                TARGET_ADDR="${res%%|*}"
                TARGET_SERVICE="${res##*|}"
                return 0
            fi
            sleep 1
        done
    fi

    return 1
}

# Auto-connect pipeline following pairing
auto_connect_device() {
    local target_ip="$1"
    local model="${2:-}"
    local os_ver="${3:-}"
    local connect_service=""
    local connect_addr=""

    echo ""
    info "Mencari service koneksi debugging (${CYAN}_adb-tls-connect._tcp${RESET})..."

    if stream_discover_mdns "_adb-tls-connect._tcp" "" "$target_ip" 10 "Menghubungkan otomatis..."; then
        connect_service="$TARGET_SERVICE"
        connect_addr="$TARGET_ADDR"
        [ -n "$TARGET_MODEL" ] && model="$TARGET_MODEL"
        [ -n "$TARGET_ANDROID" ] && os_ver="$TARGET_ANDROID"
    fi

    local connected_target=""

    # 1. Prioritaskan koneksi via mDNS TLS service name (adb-xxxx._adb-tls-connect._tcp)
    if [ -n "$connect_service" ]; then
        info "Menghubungkan via mDNS TLS: ${BOLD}$connect_service${RESET}..."
        if safe_adb_connect "$connect_service"; then
            connected_target="$connect_service"
        fi
    fi

    # 2. Fallback ke IP:Port jika koneksi mDNS service name gagal
    if [ -z "$connected_target" ] && [ -n "$connect_addr" ]; then
        info "Menghubungkan ke ${BOLD}$connect_addr${RESET}..."
        if safe_adb_connect "$connect_addr"; then
            connected_target="$connect_addr"
        fi
    fi

    if [ -n "$connected_target" ]; then
        echo ""
        success "Berhasil terhubung ke Android!"
        if [ -n "$model" ] || [ -n "$os_ver" ]; then
            echo -e "  📱 ${BOLD}Perangkat:${RESET} ${GREEN}${model:-Android Device}${RESET} (${CYAN}${os_ver:-Android}${RESET})"
        fi
        save_device_history "$target_ip" "${connect_addr##*:}" "$model" "$os_ver" "$connect_service"
        notify_desktop "Android Terhubung!" "${model:-Perangkat} ($os_ver) @ $connected_target"
        local dev_alias
        dev_alias=$(get_target_alias "$connected_target" 2>/dev/null || true)
        if [ -n "$dev_alias" ]; then
            echo -e "  🏷️  ${BOLD}Alias:${RESET} ${CYAN}${dev_alias}${RESET} ${DIM}(jaaw shell $dev_alias)${RESET}"
        else
            echo -e "  💡 ${DIM}Tip: Beri alias untuk perangkat ini: ${RESET}${BOLD}jaaw alias set <nama> $connected_target${RESET}"
        fi
        echo ""
        adb devices -l
        maybe_launch_scrcpy "$connected_target"
        return 0
    fi

    # Fallback to manual port prompt if mDNS connect didn't arrive
    warn "Port koneksi otomatis belum terdeteksi via mDNS."
    echo -e "    Lihat di layar HP: ${BOLD}Wireless debugging${RESET} > ${BOLD}IP address & Port${RESET}"
    echo -ne "    Masukkan Port (atau Enter untuk lewati) [contoh: 38475]: "
    local manual_port
    read -r manual_port || true
    if [ -n "$manual_port" ]; then
        local full_addr="$target_ip:$manual_port"
        [[ "$manual_port" == *":"* ]] && full_addr="$manual_port"
        info "Menghubungkan ke $full_addr ..."
        if safe_adb_connect "$full_addr"; then
            save_device_history "$target_ip" "$manual_port" "$model" "$os_ver" ""
            notify_desktop "Android Terhubung!" "${model:-Perangkat} @ $full_addr"
            echo ""
            adb devices -l
            maybe_launch_scrcpy "$full_addr"
        fi
    fi
}

# Mode 1: QR Code Pairing Flow
flow_qr_pairing() {
    check_dependencies

    local current_ssid
    current_ssid=$(get_wifi_ssid)

    NAME="jaaw-$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
    CODE=$(( (RANDOM * 32768 + RANDOM) % 900000 + 100000 ))
    PAYLOAD="WIFI:T:ADB;S:$NAME;P:$CODE;;"

    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}             ANDROID WIRELESS DEBUGGING (QR PAIRING)              ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    if [ -n "$current_ssid" ]; then
        echo -e "  📶 ${BOLD}Wi-Fi Aktif:${RESET} ${GREEN}${BOLD}$current_ssid${RESET}  ${DIM}(Pastikan HP terhubung ke Wi-Fi ini)${RESET}"
    fi
    echo ""
    echo -e " ${BOLD}Langkah di HP Android (Android 11 - 16):${RESET}"
    echo -e "  1. Buka ${BOLD}Settings${RESET} > ${BOLD}System${RESET} > ${BOLD}Developer options${RESET}"
    echo -e "  2. Aktifkan toggle ${BOLD}Wireless debugging${RESET}"
    echo -e "  3. Ketuk ${BOLD}Wireless debugging${RESET} > pilih ${BOLD}Pair device with QR code${RESET}"
    echo -e "  4. Arahkan kamera HP ke QR Code berikut:"
    echo ""

    render_qr

    echo ""
    echo -e "  ${DIM}Service Name:${RESET} ${CYAN}$NAME${RESET}    ${DIM}Pairing Code:${RESET} ${YELLOW}${BOLD}$CODE${RESET}"
    echo ""
    network_warning

    if ! stream_discover_mdns "_adb-tls-pairing._tcp" "$NAME" "" "$TIMEOUT" "Menunggu scan QR dari HP..."; then
        # Try generic pairing if specific service name timed out
        stream_discover_mdns "_adb-tls-pairing._tcp" "" "" 5 "Mengecek discovery alternatif..." || true
    fi

    [ -n "$TARGET_ADDR" ] || die "Tidak ada perangkat yang terdeteksi dalam ${TIMEOUT} detik."

    local phone_ip="${TARGET_ADDR%%:*}"
    local phone_model="$TARGET_MODEL"
    local phone_os="$TARGET_ANDROID"

    echo ""
    success "Perangkat terdeteksi di ${BOLD}$TARGET_ADDR${RESET}!"
    if [ -n "$phone_model" ] || [ -n "$phone_os" ]; then
        echo -e "  📱 ${BOLD}Info:${RESET} ${GREEN}${phone_model:-Device}${RESET} (${CYAN}${phone_os:-Android}${RESET})"
    fi

    info "Melakukan pairing dengan kode: ${YELLOW}${BOLD}$CODE${RESET}..."
    if adb pair "$TARGET_ADDR" "$CODE"; then
        echo ""
        success "Pairing berhasil!"
        auto_connect_device "$phone_ip" "$phone_model" "$phone_os"
    else
        die "Gagal melakukan pairing ke $TARGET_ADDR."
    fi
}

# Mode 2: Quick Connect (Discovered & Known Devices)
flow_quick_connect() {
    check_dependencies
    local current_ssid
    current_ssid=$(get_wifi_ssid)

    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}               QUICK CONNECT (ACTIVE WI-FI DEVICES)               ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    if [ -n "$current_ssid" ]; then
        echo -e "  📶 ${BOLD}Wi-Fi:${RESET} ${GREEN}${BOLD}$current_ssid${RESET}"
    fi
    echo ""
    info "Memindai perangkat Android aktif di jaringan Wi-Fi..."

    local devices=()
    local addrs=()
    local services=()
    local models=()

    if command -v avahi-browse >/dev/null 2>&1; then
        # shellcheck disable=SC2034
        while IFS=';' read -r status iface proto name type domain host ip port txt; do
            if [ "$status" = "=" ] && [ "$proto" = "IPv4" ] && [ -n "$ip" ] && [ -n "$port" ]; then
                # Deduplicate by ip:port
                local dup=false
                for existing_addr in "${addrs[@]}"; do
                    if [ "$existing_addr" = "$ip:$port" ]; then
                        dup=true
                        break
                    fi
                done
                [ "$dup" = true ] && continue

                local parsed
                parsed=$(parse_txt_record "$txt")
                local m="${parsed%%|*}"
                local a
                a=$(api_to_version "${parsed##*|}")
                local svc=""
                [ -n "$name" ] && [ -n "$type" ] && svc="$name.$type"
                local label="${m:-Device} ($a) @ ${svc:-$ip:$port}"
                devices+=("$label")
                addrs+=("$ip:$port")
                services+=("$svc")
                models+=("${m:-Unknown}")
            fi
        done < <(avahi-browse -r -p -t "_adb-tls-connect._tcp" 2>/dev/null || true)
    fi

    if [ ${#devices[@]} -eq 0 ]; then
        warn "Tidak ditemukan broadcast _adb-tls-connect._tcp otomatis."
        
        # Show recent devices from history if available
        if [ -f "$HISTORY_FILE" ] && [ -s "$HISTORY_FILE" ]; then
            echo -e "\n${BOLD}Riwayat Perangkat Terakhir:${RESET}"
            awk -F'\t' '{printf "   - %s (%s) IP Terakhir: %s\n", $4, $5, $2}' "$HISTORY_FILE"
            echo ""
        fi

        echo -ne "Masukkan IP:Port HP secara manual (contoh: 192.168.1.50:39845): "
        local manual_addr
        read -r manual_addr || true
        if [ -n "$manual_addr" ]; then
            info "Menghubungkan ke $manual_addr ..."
            if safe_adb_connect "$manual_addr"; then
                notify_desktop "Android Terhubung!" "Alamat: $manual_addr"
                maybe_launch_scrcpy "$manual_addr"
            fi
            echo ""
            adb devices -l
        fi
        return 0
    fi

    echo -e "\n${BOLD}Perangkat aktif ditemukan:${RESET}"
    local idx=1
    for dev in "${devices[@]}"; do
        echo -e "  ${BOLD}[$idx]${RESET} ${GREEN}$dev${RESET}"
        idx=$((idx + 1))
    done

    echo ""
    echo -ne "Pilih nomor [1-${#devices[@]}] atau Enter untuk connect semua: "
    local choice
    read -r choice || true

    local connected_target=""
    if [ -z "$choice" ]; then
        for i in "${!addrs[@]}"; do
            local addr="${addrs[$i]}"
            local svc="${services[$i]:-}"
            local connected=false
            if [ -n "$svc" ]; then
                info "Connecting via mDNS TLS: $svc ..."
                if safe_adb_connect "$svc"; then
                    save_device_history "${addr%%:*}" "${addr##*:}" "${models[$i]}" "" "$svc"
                    connected_target="$svc"
                    connected=true
                fi
            fi
            if [ "$connected" = false ]; then
                info "Connecting $addr ..."
                if safe_adb_connect "$addr"; then
                    save_device_history "${addr%%:*}" "${addr##*:}" "${models[$i]}" "" ""
                    connected_target="$addr"
                fi
            fi
        done
    else
        local sel=$((choice - 1))
        if [ "$sel" -ge 0 ] && [ "$sel" -lt "${#addrs[@]}" ]; then
            local addr="${addrs[$sel]}"
            local svc="${services[$sel]:-}"
            local connected=false
            if [ -n "$svc" ]; then
                info "Connecting via mDNS TLS: $svc ..."
                if safe_adb_connect "$svc"; then
                    save_device_history "${addr%%:*}" "${addr##*:}" "${models[$sel]}" "" "$svc"
                    connected_target="$svc"
                    connected=true
                fi
            fi
            if [ "$connected" = false ]; then
                info "Connecting $addr ..."
                if safe_adb_connect "$addr"; then
                    save_device_history "${addr%%:*}" "${addr##*:}" "${models[$sel]}" "" ""
                    connected_target="$addr"
                fi
            fi
        else
            warn "Pilihan tidak valid."
        fi
    fi

    if [ -n "$connected_target" ]; then
        notify_desktop "Android Terhubung!" "Alamat: $connected_target"
        echo ""
        adb devices -l
        maybe_launch_scrcpy "$connected_target"
    fi
}

# Mode 3: 1-Click USB to Wireless Switch (adb tcpip 5555)
flow_usb_to_wireless() {
    check_dependencies
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}              1-CLICK SWITCH: USB TO WIRELESS ADB                 ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    info "Memeriksa perangkat Android yang tersambung via kabel USB..."
    local usb_devices
    usb_devices=$(adb devices -l | awk 'NR>1 && $2=="device" && $1 !~ /:[0-9]+$/ {print $1}')

    if [ -z "$usb_devices" ]; then
        warn "Tidak ada perangkat USB terdeteksi."
        echo -e "    Pastikan kabel USB terpasang dan USB Debugging aktif di HP."
        return 1
    fi

    for serial in $usb_devices; do
        local model
        model=$(adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r\n' || echo "$serial")
        local os_ver
        os_ver=$(adb -s "$serial" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r\n' || echo "")
        
        info "Ditemukan perangkat USB: ${BOLD}$model${RESET} (Android $os_ver) [Serial: $serial]"
        
        # Get Phone Wi-Fi IP
        local phone_ip
        phone_ip=$(adb -s "$serial" shell ip route 2>/dev/null | awk '/src/ {print $NF; exit}' | tr -d '\r\n')
        if [ -z "$phone_ip" ]; then
            phone_ip=$(adb -s "$serial" shell ip -f inet addr show wlan0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | tr -d '\r\n')
        fi

        if [ -z "$phone_ip" ]; then
            warn "Gagal mendapatkan IP Wi-Fi otomatis dari HP."
            echo -ne "Masukkan IP Wi-Fi HP secara manual: "
            read -r phone_ip
        fi

        [ -n "$phone_ip" ] || continue

        info "Mengaktifkan port TCP/IP 5555 pada perangkat..."
        adb -s "$serial" tcpip 5555
        sleep 1

        info "Menghubungkan via Wi-Fi ke $phone_ip:5555 ..."
        if safe_adb_connect "$phone_ip:5555"; then
            echo ""
            success "Berhasil beralih ke mode Wireless ADB!"
            echo -e "  🎉 ${BOLD}Anda sekarang dapat mencabut kabel USB!${RESET}"
            save_device_history "$phone_ip" "5555" "$model" "Android $os_ver" ""
            notify_desktop "Wireless ADB Aktif!" "$model terhubung ke $phone_ip:5555"
            echo ""
            adb devices -l
            maybe_launch_scrcpy "$phone_ip:5555"
        else
            die "Gagal menghubungkan ke $phone_ip:5555."
        fi
    done
}

# Mode 4: Manual Pairing
flow_manual_pair() {
    check_dependencies
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                 MANUAL PAIRING (PAIRING CODE)                    ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
    echo -e " ${BOLD}Langkah di HP Android:${RESET}"
    echo -e "  1. Buka ${BOLD}Wireless debugging${RESET}"
    echo -e "  2. Pilih ${BOLD}'Pair device with pairing code'${RESET} (bukan QR)"
    echo -e "  3. HP akan menampilkan IP address, Port pairing, dan 6 digit Wi-Fi pairing code."
    echo ""

    echo -ne " Masukkan IP address & Port pairing (contoh: 192.168.1.50:41235): "
    local pair_addr
    read -r pair_addr
    [ -n "$pair_addr" ] || die "Alamat tidak boleh kosong."

    echo -ne " Masukkan 6-digit Wi-Fi pairing code: "
    local pair_code
    read -r pair_code
    [ -n "$pair_code" ] || die "Kode pairing tidak boleh kosong."

    info "Memasangkan dengan $pair_addr ..."
    if adb pair "$pair_addr" "$pair_code"; then
        success "Pairing berhasil!"
        local phone_ip="${pair_addr%%:*}"
        auto_connect_device "$phone_ip"
    else
        die "Pairing gagal."
    fi
}

# Mode 5: View History
flow_history() {
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                    RIWAYAT PERANGKAT TERDAFTAR                   ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
    if [ ! -f "$HISTORY_FILE" ] || [ ! -s "$HISTORY_FILE" ]; then
        info "Belum ada riwayat perangkat tersimpan."
        return 0
    fi

    printf "  %-20s %-16s %-8s %-20s %-14s\n" "TERAKHIR KONEK" "IP ADDRESS" "PORT" "MODEL" "OS"
    printf "  %-20s %-16s %-8s %-20s %-14s\n" "-------------------" "---------------" "------" "-------------------" "-------------"
    while IFS=$'\t' read -r t ip port model os s_name; do
        printf "  %-20s %-16s %-8s %-20s %-14s\n" "$t" "$ip" "$port" "$model" "$os"
    done < "$HISTORY_FILE"
    echo ""
}

# ==============================================================================
# Device Alias Management & Smart Wrapper
# ==============================================================================

parse_adb_device_line() {
    local line="$1"
    PARSED_DEV_SERIAL=""
    PARSED_DEV_STATUS=""
    PARSED_DEV_MODEL=""
    if [[ "$line" =~ ^(.+)[[:space:]]+(device|offline|unauthorized|authorizing|connecting|no[[:space:]]+permissions|recovery|sideload|bootloader)([[:space:]]+.*)?$ ]]; then
        PARSED_DEV_SERIAL="${BASH_REMATCH[1]}"
        PARSED_DEV_STATUS="${BASH_REMATCH[2]}"
        local rest="${BASH_REMATCH[3]:-}"
        if [[ "$rest" =~ model:([^[:space:]]+) ]]; then
            PARSED_DEV_MODEL="${BASH_REMATCH[1]}"
        fi
        return 0
    fi
    return 1
}

init_alias_file() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    if [ ! -f "$ALIAS_FILE" ]; then
        printf "# ALIAS\tTARGET_IDENTIFIER\tDEVICE_MODEL\tLAST_SEEN_IP_PORT\tUPDATED_AT\n" > "$ALIAS_FILE"
    fi
}

get_alias_target() {
    local alias_name="${1:-}"
    [ -n "$alias_name" ] || return 1
    [ -f "$ALIAS_FILE" ] || return 1
    local target
    target=$(awk -F'\t' -v a="$alias_name" '$1 !~ /^#/ && $1 == a { print $2; exit }' "$ALIAS_FILE")
    [ -n "$target" ] || return 1

    # Smart dynamic resolution against currently connected ADB devices
    local dev_output
    dev_output=$(adb devices -l 2>/dev/null || true)
    if [ -n "$dev_output" ]; then
        local found_serial=""
        local candidate_serial=""
        local base_id="$target"
        [[ "$base_id" =~ ^(adb-[a-zA-Z0-9_-]+) ]] && base_id="${BASH_REMATCH[1]}"

        while IFS= read -r dev_line; do
            if parse_adb_device_line "$dev_line"; then
                if [ "$PARSED_DEV_SERIAL" = "$target" ]; then
                    found_serial="$PARSED_DEV_SERIAL"
                    break
                fi
                if [ -n "$base_id" ] && [[ "$PARSED_DEV_SERIAL" == *"$base_id"* ]]; then
                    candidate_serial="$PARSED_DEV_SERIAL"
                elif [[ "$target" == *"$PARSED_DEV_SERIAL"* ]] || [[ "$PARSED_DEV_SERIAL" == *"$target"* ]]; then
                    candidate_serial="$PARSED_DEV_SERIAL"
                fi
            fi
        done < <(echo "$dev_output" | tail -n +2)

        if [ -n "$found_serial" ]; then
            echo "$found_serial"
            return 0
        elif [ -n "$candidate_serial" ]; then
            echo "$candidate_serial"
            return 0
        fi
    fi

    echo "$target"
}

get_target_alias() {
    local target="${1:-}"
    [ -n "$target" ] || return 1
    [ -f "$ALIAS_FILE" ] || return 1
    local base_id="$target"
    [[ "$base_id" =~ ^(adb-[a-zA-Z0-9_-]+) ]] && base_id="${BASH_REMATCH[1]}"

    awk -F'\t' -v t="$target" -v b="$base_id" '
    $1 !~ /^#/ {
        if ($2 == t || $4 == t || (b != "" && index($2, b) > 0) || (index($2, t) > 0 && t != "") || (index(t, $2) > 0 && $2 != "")) {
            print $1
            exit
        }
    }' "$ALIAS_FILE" | grep .
}

resolve_target() {
    local input="${1:-}"
    [ -n "$input" ] || die "Target serial atau nama alias harus ditentukan."
    local target
    if target=$(get_alias_target "$input" 2>/dev/null); then
        echo "$target"
        return 0
    fi
    echo "$input"
}

set_device_alias() {
    local alias_name="${1:-}"
    local target="${2:-}"
    local model="${3:-}"
    local ip_port="${4:-}"

    init_alias_file

    if [ -z "$alias_name" ]; then
        echo -ne "Masukkan nama alias (contoh: poco, tab, pixel): "
        read -r alias_name || true
    fi

    [ -n "$alias_name" ] || die "Nama alias tidak boleh kosong."

    if ! [[ "$alias_name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        die "Nama alias hanya boleh menggunakan huruf, angka, titik, minus, atau underscore."
    fi

    # Interactive picker if target not supplied
    if [ -z "$target" ]; then
        local cand_targets=()
        local cand_labels=()
        local cand_models=()
        local cand_addrs=()

        # Connected ADB devices
        while IFS= read -r line; do
            if parse_adb_device_line "$line"; then
                local serial="$PARSED_DEV_SERIAL"
                local status="$PARSED_DEV_STATUS"
                local m="${PARSED_DEV_MODEL:-Device}"
                cand_targets+=("$serial")
                cand_models+=("$m")
                cand_addrs+=("")
                cand_labels+=("ADB Connected: ${BOLD}$serial${RESET} (${GREEN}$m${RESET} - $status)")
            fi
        done < <(adb devices -l 2>/dev/null | tail -n +2)

        # History devices
        if [ -f "$HISTORY_FILE" ]; then
            while IFS=$'\t' read -r t ip port m os s_name; do
                [ -n "$ip" ] || continue
                local t_id="${s_name:-$ip:$port}"
                local dup=false
                for ct in "${cand_targets[@]}"; do
                    if [ "$ct" = "$t_id" ]; then dup=true; break; fi
                done
                if [ "$dup" = false ]; then
                    cand_targets+=("$t_id")
                    cand_models+=("${m:-Device}")
                    cand_addrs+=("$ip:$port")
                    cand_labels+=("Riwayat: ${BOLD}$t_id${RESET} (${GREEN}${m:-Device}${RESET} @ $ip:$port)")
                fi
            done < "$HISTORY_FILE"
        fi

        if [ ${#cand_targets[@]} -gt 0 ]; then
            echo -e "\n${BOLD}Pilih perangkat untuk alias '${CYAN}$alias_name${RESET}':"
            local idx=1
            for lbl in "${cand_labels[@]}"; do
                echo -e "  ${BOLD}[$idx]${RESET} $lbl"
                idx=$((idx + 1))
            done
            echo -e "  ${BOLD}[m]${RESET} Masukkan target serial / mDNS service / IP:Port manual"
            echo ""
            echo -ne "Pilih [1-${#cand_targets[@]}, m]: "
            local sel
            read -r sel || true
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#cand_targets[@]}" ]; then
                local s_idx=$((sel - 1))
                target="${cand_targets[$s_idx]}"
                [ -z "$model" ] && model="${cand_models[$s_idx]}"
                [ -z "$ip_port" ] && ip_port="${cand_addrs[$s_idx]}"
            else
                echo -ne "Masukkan serial/mDNS service/IP:Port: "
                read -r target || true
            fi
        else
            echo -ne "Masukkan serial/mDNS service/IP:Port: "
            read -r target || true
        fi
    fi

    [ -n "$target" ] || die "Target serial perangkat tidak boleh kosong."

    # Try to resolve model / IP:Port if missing
    if [ -z "$model" ] || [ "$model" = "Unknown" ]; then
        if [ -f "$HISTORY_FILE" ]; then
            local hist_match
            hist_match=$(awk -F'\t' -v t="$target" '$6 == t || ($2 ":" $3) == t || $2 == t { print $4 "\t" $2 ":" $3; exit }' "$HISTORY_FILE")
            if [ -n "$hist_match" ]; then
                [ -z "$model" ] && model=$(echo "$hist_match" | cut -f1)
                [ -z "$ip_port" ] && ip_port=$(echo "$hist_match" | cut -f2)
            fi
        fi
        if [ -z "$model" ] || [ "$model" = "Unknown" ]; then
            local dev_line
            dev_line=$(adb devices -l 2>/dev/null | grep -F "$target" | head -n 1 || true)
            if [[ "$dev_line" =~ model:([^[:space:]]+) ]]; then
                model="${BASH_REMATCH[1]}"
            fi
        fi
    fi

    if [ -z "$ip_port" ]; then
        if [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$ ]]; then
            ip_port="$target"
        fi
    fi

    local now
    now=$(date '+%Y-%m-%d %H:%M:%S')

    local tmp_file
    tmp_file=$(mktemp "${TMPDIR:-/tmp}/jaaw-alias.XXXXXX")
    if [ -f "$ALIAS_FILE" ]; then
        awk -F'\t' -v a="$alias_name" 'NR==1 || ($1 !~ /^#/ && $1 != a)' "$ALIAS_FILE" > "$tmp_file" 2>/dev/null || true
    else
        printf "# ALIAS\tTARGET_IDENTIFIER\tDEVICE_MODEL\tLAST_SEEN_IP_PORT\tUPDATED_AT\n" > "$tmp_file"
    fi

    printf "%s\t%s\t%s\t%s\t%s\n" "$alias_name" "$target" "${model:-Unknown}" "${ip_port:--}" "$now" >> "$tmp_file"
    mv "$tmp_file" "$ALIAS_FILE"

    success "Alias '${BOLD}${CYAN}$alias_name${RESET}' berhasil disimpan -> ${BOLD}$target${RESET} (${GREEN}${model:-Unknown}${RESET})"
}

remove_device_alias() {
    local alias_name="${1:-}"
    [ -n "$alias_name" ] || die "Nama alias harus ditentukan (contoh: jaaw alias rm poco)."
    [ -f "$ALIAS_FILE" ] || die "Belum ada alias yang tersimpan."

    if ! grep -q -E "^${alias_name}[[:space:]]" "$ALIAS_FILE" 2>/dev/null; then
        die "Alias '$alias_name' tidak ditemukan."
    fi

    local tmp_file
    tmp_file=$(mktemp "${TMPDIR:-/tmp}/jaaw-alias.XXXXXX")
    awk -F'\t' -v a="$alias_name" 'NR==1 || ($1 !~ /^#/ && $1 != a)' "$ALIAS_FILE" > "$tmp_file"
    mv "$tmp_file" "$ALIAS_FILE"

    success "Alias '${BOLD}${CYAN}$alias_name${RESET}' berhasil dihapus."
}

list_device_aliases() {
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                    DAFTAR ALIAS PERANGKAT                        ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    if [ ! -f "$ALIAS_FILE" ] || [ "$(grep -v '^#' "$ALIAS_FILE" 2>/dev/null | grep -c . || true)" -eq 0 ]; then
        info "Belum ada alias yang didaftarkan."
        echo -e "  Gunakan: ${BOLD}jaaw alias set <nama> [target]${RESET} untuk membuat alias baru."
        echo -e "  Contoh : ${BOLD}jaaw alias set poco${RESET}"
        echo ""
        return 0
    fi

    printf "  %-12s %-16s %-20s %-40s\n" "ALIAS" "MODEL" "IP:PORT" "TARGET / REAL SERIAL"
    printf "  %-12s %-16s %-20s %-40s\n" "------------" "----------------" "--------------------" "----------------------------------------"

    while IFS=$'\t' read -r a target m ip_port updated; do
        [[ "$a" =~ ^# ]] && continue
        [ -n "$a" ] || continue
        printf "  ${CYAN}%-12s${RESET} ${GREEN}%-16s${RESET} %-20s %-40s\n" "$a" "${m:-Unknown}" "${ip_port:--}" "$target"
    done < "$ALIAS_FILE"
    echo ""
    echo -e "  ${DIM}Tip: Jalankan 'jaaw shell <alias>' atau 'jaaw exec <alias> <perintah>'${RESET}"
    echo ""
}

flow_alias() {
    local subcmd="${1:-list}"
    shift || true
    case "$subcmd" in
        set|add)
            set_device_alias "$@"
            ;;
        rm|remove|del|delete)
            remove_device_alias "$@"
            ;;
        get)
            local target
            target=$(get_alias_target "${1:-}" 2>/dev/null) || return 1
            echo "$target"
            ;;
        list|ls)
            list_device_aliases
            ;;
        *)
            if [ -n "$subcmd" ]; then
                local target
                if target=$(get_alias_target "$subcmd" 2>/dev/null); then
                    info "Alias ${CYAN}$subcmd${RESET} -> ${BOLD}$target${RESET}"
                    return 0
                fi
            fi
            echo "Usage: jaaw alias [set|list|rm|get] [ARGS...]" >&2
            return 1
            ;;
    esac
}

flow_devices() {
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                 PERANGKAT TERHUBUNG (ADB DEVICES)                ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    local raw_devices
    raw_devices=$(adb devices -l 2>/dev/null | tail -n +2 || true)

    if [ -z "$raw_devices" ] || [ "$(echo "$raw_devices" | grep -c . || true)" -eq 0 ]; then
        warn "Tidak ada perangkat Android yang terhubung saat ini."
        echo -e "  Hubungkan dengan: ${BOLD}jaaw connect${RESET} atau ${BOLD}jaaw pair${RESET}"
        echo ""
        return 0
    fi

    printf "  %-12s %-16s %-10s %-22s %-40s\n" "ALIAS" "MODEL" "STATUS" "IP:PORT" "REAL SERIAL / SERVICE"
    printf "  %-12s %-16s %-10s %-22s %-40s\n" "------------" "----------------" "----------" "----------------------" "----------------------------------------"

    while IFS= read -r line; do
        if ! parse_adb_device_line "$line"; then
            continue
        fi
        local serial="$PARSED_DEV_SERIAL"
        local status="$PARSED_DEV_STATUS"
        local model="${PARSED_DEV_MODEL:--}"

        local alias_name="-"
        local ip_port="-"

        if [ -f "$ALIAS_FILE" ]; then
            while IFS=$'\t' read -r a t m i_p u; do
                [[ "$a" =~ ^# ]] && continue
                [ -n "$a" ] || continue
                local base_t="$t"
                [[ "$base_t" =~ ^(adb-[a-zA-Z0-9_-]+) ]] && base_t="${BASH_REMATCH[1]}"
                if [ "$t" = "$serial" ] || [ "$i_p" = "$serial" ] || [[ "$serial" == *"$base_t"* ]]; then
                    alias_name="$a"
                    [ "$ip_port" = "-" ] && [ -n "$i_p" ] && [ "$i_p" != "-" ] && ip_port="$i_p"
                    [ "$model" = "-" ] && [ -n "$m" ] && [ "$m" != "Unknown" ] && model="$m"
                    break
                fi
            done < "$ALIAS_FILE"
        fi

        if [ "$ip_port" = "-" ]; then
            if [[ "$serial" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$ ]]; then
                ip_port="$serial"
            elif [ -f "$HISTORY_FILE" ]; then
                local hist_ip
                hist_ip=$(awk -F'\t' -v s="$serial" '($6 != "" && ($6 == s || index(s, $6) > 0 || index($6, s) > 0)) { print $2 ":" $3; exit }' "$HISTORY_FILE" 2>/dev/null || true)
                [ -n "$hist_ip" ] && ip_port="$hist_ip"
            fi
        fi

        local status_color="$GREEN"
        if [ "$status" != "device" ]; then
            status_color="$YELLOW"
        fi

        local alias_disp="${CYAN}$alias_name${RESET}"
        [ "$alias_name" = "-" ] && alias_disp="${DIM}-${RESET}"

        printf "  %-21b ${BOLD}%-16s${RESET} ${status_color}%-10s${RESET} %-22s %-40s\n" \
            "$alias_disp" "$model" "$status" "$ip_port" "$serial"

    done <<< "$raw_devices"

    echo ""
}

flow_exec() {
    [ $# -ge 2 ] || die "Penggunaan: jaaw exec <alias|target> <perintah...>\nContoh: jaaw exec poco shell ls /sdcard"
    local target
    target=$(resolve_target "$1")
    shift
    exec adb -s "$target" "$@"
}

flow_shell() {
    [ $# -ge 1 ] || die "Penggunaan: jaaw shell <alias|target> [args...]\nContoh: jaaw shell poco"
    local target
    target=$(resolve_target "$1")
    shift
    exec adb -s "$target" shell "$@"
}

flow_scrcpy() {
    [ $# -ge 1 ] || die "Penggunaan: jaaw scrcpy <alias|target> [scrcpy-args...]\nContoh: jaaw scrcpy poco -b 4M"
    local target
    target=$(resolve_target "$1")
    shift
    LAUNCH_SCRCPY=true
    if [ $# -gt 0 ]; then
        SCRCPY_CUSTOM_ARGS+=("$@")
    fi
    maybe_launch_scrcpy "$target"
}

flow_use() {
    local alias_name="${1:-}"
    if [ -z "$alias_name" ]; then
        if [ ! -f "$ALIAS_FILE" ] || [ "$(grep -v '^#' "$ALIAS_FILE" 2>/dev/null | grep -c . || true)" -eq 0 ]; then
            die "Belum ada alias terdaftar. Buat alias dengan: jaaw alias set <nama>"
        fi
        echo -e "${BOLD}Pilih alias untuk digunakan sebagai target aktif:${RESET}"
        local list=()
        while IFS=$'\t' read -r a t m ip_port u; do
            [[ "$a" =~ ^# ]] && continue
            [ -n "$a" ] || continue
            list+=("$a")
        done < "$ALIAS_FILE"
        local idx=1
        for a in "${list[@]}"; do
            echo "  [$idx] $a"
            idx=$((idx + 1))
        done
        echo -ne "Pilih nomor [1-${#list[@]}]: "
        local sel
        read -r sel || true
        if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#list[@]}" ]; then
            alias_name="${list[$((sel-1))]}"
        else
            die "Pilihan tidak valid."
        fi
    fi

    local target
    target=$(resolve_target "$alias_name")

    echo "export ANDROID_SERIAL=\"$target\""
    echo -e "${GREEN}[✓] Target aktif diatur ke '${CYAN}${alias_name}${RESET}${GREEN}' (${BOLD}${target}${RESET}${GREEN})${RESET}" >&2
    echo -e "${DIM}Gunakan di sesi shell: ${BOLD}eval \"\$(jaaw use $alias_name)\"${RESET}" >&2
}

flow_init() {
    local sh_type="${1:-}"
    if [ -z "$sh_type" ]; then
        if [ -n "${ZSH_VERSION:-}" ] || [[ "${SHELL:-}" == *"zsh"* ]]; then
            sh_type="zsh"
        elif [ -n "${FISH_VERSION:-}" ] || [[ "${SHELL:-}" == *"fish"* ]]; then
            sh_type="fish"
        else
            sh_type="bash"
        fi
    fi

    local self_bin
    self_bin=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || command -v jaaw 2>/dev/null || echo "/usr/local/bin/jaaw")

    case "$sh_type" in
        zsh)
            cat <<EOF
# jaaw smart adb wrapper & completion for Zsh
adb() {
    local -a adb_args=()
    while [ \$# -gt 0 ]; do
        case "\$1" in
            -s)
                if [ \$# -ge 2 ]; then
                    local real_target
                    real_target=\$(command jaaw alias get "\$2" 2>/dev/null || "$self_bin" alias get "\$2" 2>/dev/null || echo "\$2")
                    adb_args+=("-s" "\$real_target")
                    shift 2
                else
                    adb_args+=("\$1")
                    shift
                fi
                ;;
            -s*)
                local target="\${1#-s}"
                local real_target
                real_target=\$(command jaaw alias get "\$target" 2>/dev/null || "$self_bin" alias get "\$target" 2>/dev/null || echo "\$target")
                adb_args+=("-s\$real_target")
                shift
                ;;
            *)
                adb_args+=("\$1")
                shift
                ;;
        esac
    done
    command adb "\${adb_args[@]}"
}

_jaaw_aliases() {
    local alias_file="\${XDG_CONFIG_HOME:-\$HOME/.config}/jaaw/aliases.tsv"
    if [[ -f "\$alias_file" ]]; then
        local -a dev_aliases
        while IFS=\$'\t' read -r a target m ip_port updated; do
            [[ "\$a" =~ ^# ]] && continue
            [[ -n "\$a" ]] && dev_aliases+=("\$a:\${m:-Device} (\$target)")
        done < "\$alias_file"
        _describe -t aliases 'jaaw alias' dev_aliases
    fi
}

_adb_device_serial() {
    _jaaw_aliases
    local -a raw_devices
    local line dev_regex
    dev_regex="^(.+)[[:space:]]+(device|offline|unauthorized|recovery)"
    while IFS= read -r line; do
        [[ -z "\$line" || "\$line" =~ ^List ]] && continue
        if [[ "\$line" =~ \$dev_regex ]]; then
            raw_devices+=("\${match[1]}")
        fi
    done < <(command adb devices 2>/dev/null)
    if (( \${#raw_devices} > 0 )); then
        _describe -t devices 'connected adb device' raw_devices
    fi
}

_jaaw_adb_complete() {
    if [[ "\$words[CURRENT-1]" == "-s" ]]; then
        _adb_device_serial
        return
    fi
    if (( \$+functions[_adb] )); then
        _adb "\$@"
    fi
}

if (( \$+functions[compdef] )); then
    local zsh_adb_builtin
    for zsh_adb_builtin in /usr/share/zsh/*/functions/_adb; do
        if [[ -f "\$zsh_adb_builtin" ]]; then
            source "\$zsh_adb_builtin" 2>/dev/null || true
            compdef _adb adb 2>/dev/null || true
            break
        fi
    done
    if ! (( \$+functions[_adb] )); then
        compdef _jaaw_adb_complete adb 2>/dev/null || true
    fi
fi
EOF
            ;;
        bash)
            cat <<EOF
# jaaw smart adb wrapper & completion for Bash
adb() {
    local -a adb_args=()
    while [ \$# -gt 0 ]; do
        case "\$1" in
            -s)
                if [ \$# -ge 2 ]; then
                    local real_target
                    real_target=\$(command jaaw alias get "\$2" 2>/dev/null || "$self_bin" alias get "\$2" 2>/dev/null || echo "\$2")
                    adb_args+=("-s" "\$real_target")
                    shift 2
                else
                    adb_args+=("\$1")
                    shift
                fi
                ;;
            -s*)
                local target="\${1#-s}"
                local real_target
                real_target=\$(command jaaw alias get "\$target" 2>/dev/null || "$self_bin" alias get "\$target" 2>/dev/null || echo "\$target")
                adb_args+=("-s\$real_target")
                shift
                ;;
            *)
                adb_args+=("\$1")
                shift
                ;;
        esac
    done
    command adb "\${adb_args[@]}"
}

_jaaw_adb_complete_bash() {
    local cur prev
    cur="\${COMP_WORDS[COMP_CWORD]}"
    prev="\${COMP_WORDS[COMP_CWORD-1]}"
    if [ "\$prev" = "-s" ]; then
        local aliases=""
        local alias_file="\${XDG_CONFIG_HOME:-\$HOME/.config}/jaaw/aliases.tsv"
        if [ -f "\$alias_file" ]; then
            aliases=\$(awk -F'\t' '\$1 !~ /^#/ && NF {print \$1}' "\$alias_file" 2>/dev/null | tr '\n' ' ')
        fi
        local devices
        devices=\$(command adb devices 2>/dev/null | awk 'NR>1 && NF>=2 {print \$1}')
        COMPREPLY=( \$(compgen -W "\${aliases} \${devices}" -- "\${cur}") )
        return 0
    fi
    if declare -F _adb >/dev/null 2>&1; then
        _adb "\$@"
    fi
}
if declare -F complete >/dev/null 2>&1; then
    complete -F _jaaw_adb_complete_bash adb
fi
EOF
            ;;
        fish)
            cat <<EOF
# jaaw smart adb wrapper for Fish
function adb --wraps adb
    set -l new_args
    set -l skip 0
    set -l total (count \$argv)
    for i in (seq 1 \$total)
        if test \$skip -gt 0
            set skip (math \$skip - 1)
            continue
        end
        set -l arg \$argv[\$i]
        if test "\$arg" = "-s"
            set -l next_i (math \$i + 1)
            if test \$next_i -le \$total
                set -l target \$argv[\$next_i]
                set -l real_target (command jaaw alias get "\$target" 2>/dev/null; or "$self_bin" alias get "\$target" 2>/dev/null; or echo "\$target")
                set -a new_args "-s" "\$real_target"
                set skip 1
            else
                set -a new_args "\$arg"
            end
        else
            set -a new_args "\$arg"
        end
    end
    command adb \$new_args
end

function __jaaw_adb_aliases
    set -l alias_file "\$HOME/.config/jaaw/aliases.tsv"
    if test -f "\$alias_file"
        awk -F'\t' '\$1 !~ /^#/ && NF {printf "%s\t%s (%s)\n", \$1, \$3, \$2}' "\$alias_file" 2>/dev/null
    end
end
complete -c adb -s s -a "(__jaaw_adb_aliases)"
EOF
            ;;
        *)
            echo "Shell '$sh_type' tidak didukung. Pilihan: bash, zsh, fish" >&2
            return 1
            ;;
    esac
}

# Mode 6: Diagnostics & Fedora health check
flow_diagnostics() {
    local current_ssid
    current_ssid=$(get_wifi_ssid)

    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                 FEDORA / LINUX SYSTEM DIAGNOSTICS                ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    echo -e "${BOLD}1. Tool Checks:${RESET}"
    for tool in adb qrencode avahi-browse firewall-cmd ip nmcli scrcpy notify-send; do
        if command -v "$tool" >/dev/null 2>&1; then
            echo -e "   [✓] $tool: ${GREEN}$(command -v "$tool")${RESET}"
        else
            echo -e "   [✗] $tool: ${RED}Not installed${RESET} ($(install_hint "$tool"))"
        fi
    done

    echo ""
    echo -e "${BOLD}2. ADB Capabilities:${RESET}"
    echo -e "   ADB Version: $(adb version 2>&1 | head -n 2 | tr '\n' ' ')"
    if adb mdns check >/dev/null 2>&1; then
        echo -e "   ADB mDNS Support: ${GREEN}Enabled (Built-in)${RESET}"
    else
        echo -e "   ADB mDNS Support: ${YELLOW}Disabled in distro package (Avahi streaming active)${RESET}"
    fi

    echo ""
    echo -e "${BOLD}3. Avahi Daemon (mDNS / Zeroconf):${RESET}"
    if systemctl is-active avahi-daemon >/dev/null 2>&1; then
        echo -e "   avahi-daemon status: ${GREEN}Active & Running${RESET}"
    else
        echo -e "   avahi-daemon status: ${RED}Inactive / Not running${RESET}"
        echo -e "   Jalankan: ${BOLD}sudo systemctl enable --now avahi-daemon${RESET}"
    fi

    echo ""
    echo -e "${BOLD}4. Firewall Status (firewalld):${RESET}"
    if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
        local zone
        zone=$(firewall-cmd --get-default-zone 2>/dev/null || echo "default")
        echo -e "   firewalld default zone: ${CYAN}$zone${RESET}"
        if firewall-cmd --list-services 2>/dev/null | grep -qw mdns; then
            echo -e "   mDNS service (5353/udp): ${GREEN}Allowed in firewall${RESET}"
        else
            echo -e "   mDNS service (5353/udp): ${YELLOW}Not explicitly listed in active zone${RESET}"
            echo -e "   Jika scan mDNS gagal, jalankan:"
            echo -e "   ${BOLD}sudo firewall-cmd --add-service=mdns --permanent && sudo firewall-cmd --reload${RESET}"
        fi
    else
        echo -e "   firewalld: Not active or not installed."
    fi

    echo ""
    echo -e "${BOLD}5. Wi-Fi & Active Network Interfaces:${RESET}"
    if [ -n "$current_ssid" ]; then
        echo -e "   Connected Wi-Fi SSID: ${GREEN}${BOLD}$current_ssid${RESET}"
    fi
    if command -v ip >/dev/null 2>&1; then
        ip -o -f inet addr show | awk '{printf "   Interface: %-12s IP: %s\n", $2, $4}'
    fi

    echo ""
    echo -e "${BOLD}6. Currently Connected ADB Devices:${RESET}"
    adb devices -l
    echo ""
}

# Mode 7: Reset ADB Server
flow_reset_adb() {
    info "Memutus semua koneksi dan merestart ADB server..."
    adb disconnect 2>/dev/null || true
    adb kill-server 2>/dev/null || true
    adb start-server
    success "ADB server berhasil di-restart."
    echo ""
    adb devices -l
}

# Mode 8: Self-updater from GitHub
flow_update() {
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}${BOLD}                   MEMERIKSA PEMBARUAN JAAW                       ${RESET}"
    echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    if ! command -v curl >/dev/null 2>&1; then
        die "'curl' diperlukan untuk mengunduh pembaruan. Silakan install curl terlebih dahulu."
    fi

    info "Memeriksa versi terbaru dari GitHub Releases..."
    local api_url="https://api.github.com/repos/neflalabs/jaaw/releases/latest"
    local raw_base="https://raw.githubusercontent.com/neflalabs/jaaw"
    local remote_ver=""
    local download_ref="main"

    # 1. Query GitHub Releases API for latest release tag
    local release_json
    release_json=$(curl -fsSL -H "Accept: application/vnd.github.v3+json" "$api_url" 2>/dev/null || true)
    if [ -n "$release_json" ]; then
        remote_ver=$(echo "$release_json" | grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d'"' -f4 || true)
        if [ -n "$remote_ver" ]; then
            download_ref="$remote_ver"
        fi
    fi

    # 2. Fallback to checking VERSION in raw main script if GitHub Releases not yet published
    local remote_content=""
    if [ -z "$remote_ver" ]; then
        remote_content=$(curl -fsSL "$raw_base/main/bin/jaaw" 2>/dev/null || true)
        remote_ver=$(echo "$remote_content" | grep '^VERSION=' | head -n 1 | cut -d'"' -f2 || true)
    else
        remote_content=$(curl -fsSL "$raw_base/${download_ref}/bin/jaaw" 2>/dev/null || true)
    fi

    if [ -z "$remote_ver" ] || [ -z "$remote_content" ]; then
        die "Gagal memeriksa informasi versi dari GitHub. Periksa koneksi internet Anda."
    fi

    echo -e "  Versi Terpasang : ${BOLD}$VERSION${RESET}"
    echo -e "  Versi Terbaru   : ${GREEN}${BOLD}$remote_ver${RESET}"
    echo ""

    if [ "$VERSION" = "$remote_ver" ]; then
        success "jaaw sudah dalam versi terbaru (${GREEN}$VERSION${RESET}). Tidak ada pembaruan."
        return 0
    fi

    info "Mengunduh pembaruan versi ${GREEN}$remote_ver${RESET} (ref: $download_ref)..."

    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/jaaw-update.XXXXXX")
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir' 2>/dev/null || true" RETURN

    local tmp_bin="$tmp_dir/jaaw"
    echo "$remote_content" > "$tmp_bin"
    chmod +x "$tmp_bin"

    # Validate syntax before installing
    if ! bash -n "$tmp_bin" 2>/dev/null; then
        die "Validasi skrip pembaruan gagal (syntax error). Update dibatalkan demi keamanan."
    fi

    # Find the target binary location
    local target_bin
    target_bin=$(command -v jaaw 2>/dev/null || true)
    if [ -z "$target_bin" ] || [ ! -f "$target_bin" ]; then
        target_bin="/usr/local/bin/jaaw"
    fi

    # Resolve symlinks if needed
    if [ -L "$target_bin" ]; then
        target_bin=$(readlink -f "$target_bin" 2>/dev/null || echo "$target_bin")
    fi

    info "Memasang jaaw ke $target_bin ..."
    if [ -w "$target_bin" ] || [ -w "$(dirname "$target_bin")" ]; then
        install -m 0755 "$tmp_bin" "$target_bin"
    elif command -v sudo >/dev/null 2>&1; then
        echo -e "${YELLOW}[!] Memerlukan izin sudo untuk memperbarui $target_bin:${RESET}"
        sudo install -m 0755 "$tmp_bin" "$target_bin"
    else
        die "Tidak memiliki izin menulis ke $target_bin dan 'sudo' tidak ditemukan."
    fi

    # Update shell completions from the release ref
    curl -fsSL "$raw_base/${download_ref}/completions/jaaw.bash" -o "$tmp_dir/jaaw.bash" 2>/dev/null || true
    curl -fsSL "$raw_base/${download_ref}/completions/_jaaw" -o "$tmp_dir/_jaaw" 2>/dev/null || true
    curl -fsSL "$raw_base/${download_ref}/completions/jaaw.fish" -o "$tmp_dir/jaaw.fish" 2>/dev/null || true

    for bash_dir in /usr/share/bash-completion/completions /etc/bash_completion.d; do
        if [ -d "$bash_dir" ] && [ -f "$tmp_dir/jaaw.bash" ]; then
            if [ -w "$bash_dir" ]; then
                install -m 0644 "$tmp_dir/jaaw.bash" "$bash_dir/jaaw" 2>/dev/null || true
            elif command -v sudo >/dev/null 2>&1; then
                sudo install -m 0644 "$tmp_dir/jaaw.bash" "$bash_dir/jaaw" 2>/dev/null || true
            fi
            break
        fi
    done

    local zsh_dir="/usr/share/zsh/site-functions"
    if [ -d "$zsh_dir" ] && [ -f "$tmp_dir/_jaaw" ]; then
        if [ -w "$zsh_dir" ]; then
            install -m 0644 "$tmp_dir/_jaaw" "$zsh_dir/_jaaw" 2>/dev/null || true
        elif command -v sudo >/dev/null 2>&1; then
            sudo install -m 0644 "$tmp_dir/_jaaw" "$zsh_dir/_jaaw" 2>/dev/null || true
        fi
    fi

    local fish_dir="/usr/share/fish/vendor_completions.d"
    if [ -d "$fish_dir" ] && [ -f "$tmp_dir/jaaw.fish" ]; then
        if [ -w "$fish_dir" ]; then
            install -m 0644 "$tmp_dir/jaaw.fish" "$fish_dir/jaaw.fish" 2>/dev/null || true
        elif command -v sudo >/dev/null 2>&1; then
            sudo install -m 0644 "$tmp_dir/jaaw.fish" "$fish_dir/jaaw.fish" 2>/dev/null || true
        fi
    fi

    echo ""
    success "jaaw berhasil diperbarui ke versi ${GREEN}${BOLD}$remote_ver${RESET}!"
}

# Interactive Wizard Menu
flow_wizard_menu() {
    while true; do
        local current_ssid
        current_ssid=$(get_wifi_ssid)

        echo -e "\n${CYAN}${BOLD}==================================================================${RESET}"
        echo -e "${GREEN}${BOLD}        ADB WIRELESS DEBUGGING WIZARD (FEDORA / ANDROID 16)       ${RESET}"
        echo -e "${CYAN}${BOLD}==================================================================${RESET}"
        if [ -n "$current_ssid" ]; then
            echo -e "  📶 ${BOLD}Wi-Fi:${RESET} ${GREEN}${BOLD}$current_ssid${RESET}"
            echo -e "${CYAN}------------------------------------------------------------------${RESET}"
        fi
        echo -e "  ${BOLD}[1]${RESET} Scan QR Code (Pairing & Auto-Connect baru)"
        echo -e "  ${BOLD}[2]${RESET} Quick Connect (Hubungkan ke HP di jaringan Wi-Fi)"
        echo -e "  ${BOLD}[3]${RESET} 1-Click USB to Wireless (Alihkan USB ke Wi-Fi port 5555)"
        echo -e "  ${BOLD}[4]${RESET} Mirror Layar dengan scrcpy"
        echo -e "  ${BOLD}[5]${RESET} Manual Pairing (Menggunakan 6-digit Code & IP:Port)"
        echo -e "  ${BOLD}[6]${RESET} Riwayat Perangkat (History)"
        echo -e "  ${BOLD}[7]${RESET} Daftar Perangkat Aktif & Alias (jaaw devices)"
        echo -e "  ${BOLD}[8]${RESET} Kelola Alias Perangkat (jaaw alias)"
        echo -e "  ${BOLD}[9]${RESET} System Diagnostics (Cek Avahi, Firewall, & Paket Fedora)"
        echo -e "  ${BOLD}[10]${RESET} Reset / Restart ADB Server"
        echo -e "  ${BOLD}[11]${RESET} Cek Pembaruan (Update jaaw)"
        echo -e "  ${BOLD}[0]${RESET} Keluar"
        echo -e "${CYAN}------------------------------------------------------------------${RESET}"
        echo -ne "Pilih menu [1-11, 0, a, d]: "
        local opt
        read -r opt || true
        echo ""

        case "$opt" in
            1) flow_qr_pairing; break ;;
            2) flow_quick_connect; break ;;
            3) flow_usb_to_wireless; break ;;
            4) 
               LAUNCH_SCRCPY=true
               flow_quick_connect
               break 
               ;;
            5) flow_manual_pair; break ;;
            6) flow_history ;;
            7|d|D) flow_devices ;;
            8|a|A) flow_alias ;;
            9) flow_diagnostics ;;
            10) flow_reset_adb ;;
            11) flow_update ;;
            0|q|Q) echo "Sampai jumpa!"; exit 0 ;;
            *) warn "Pilihan tidak valid, silakan coba lagi." ;;
        esac
    done
}

show_version() {
    echo -e "${CYAN}${BOLD}jaaw${RESET} version ${GREEN}${VERSION}${RESET}"
    echo -e "Jembatan Awakutu Android Wireless (Android Debug Bridge Wireless Companion)"
    echo ""
    echo -e "  ${BOLD}Created by:${RESET}  Neflalabs"
    echo -e "  ${BOLD}Website:${RESET}     https://npx.my.id"
    echo -e "  ${BOLD}GitHub:${RESET}      https://github.com/neflalabs/jaaw"
    echo -e "  ${BOLD}Instagram:${RESET}   @neflalabs (https://instagram.com/neflalabs)"
}

show_quick_help() {
    echo -e "$(cat <<EOF
${BOLD}${CYAN}jaaw${RESET} ${DIM}${VERSION} — Jembatan Awakutu Android Wireless${RESET}

${BOLD}Penggunaan:${RESET} jaaw [perintah|opsi]

${BOLD}Perintah Utama:${RESET}
  ${GREEN}pair, -p${RESET}            Pairing via QR Code & auto-connect
  ${GREEN}connect, -c${RESET}         Koneksi cepat ke perangkat aktif di Wi-Fi
  ${GREEN}devices${RESET}             Tampilkan daftar perangkat & mapping alias
  ${GREEN}wizard, -w${RESET}          Menu wizard interaktif (TUI)

${BOLD}Device Alias & Kontrol:${RESET}
  ${CYAN}alias [set|list|rm]${RESET} Kelola alias nama perangkat
  ${CYAN}shell <alias>${RESET}       Buka ADB shell interaktif
  ${CYAN}scrcpy <alias>${RESET}      Mirror layar perangkat (scrcpy)
  ${CYAN}use <alias>${RESET}         Pilih perangkat aktif (export ANDROID_SERIAL)
  ${CYAN}init${RESET}                Inisialisasi wrapper shell 'adb -s <alias>'

${BOLD}Opsi Cepat:${RESET}
  ${YELLOW}-s, --screen${RESET}        Auto-mirror screen setelah connect
  ${YELLOW}-u, --usb${RESET}           Alihkan perangkat USB ke Wireless (port 5555)
  ${YELLOW}-d, --diag${RESET}          Diagnostik sistem & firewall
  ${YELLOW}-r, --reset${RESET}         Restart ADB server
  ${YELLOW}-h, --help${RESET}          Bantuan lengkap dan opsi lanjutan

${DIM}Tips: Jalankan ${BOLD}jaaw -w${RESET}${DIM} untuk wizard TUI, atau ${BOLD}jaaw --help${RESET}${DIM} untuk bantuan lengkap.${RESET}
EOF
)"
}

usage() {
    echo -e "$(cat <<EOF
${BOLD}${CYAN}jaaw${RESET} — Jembatan Awakutu Android Wireless (${GREEN}${VERSION}${RESET})
${DIM}ADB Wireless Companion & Device Alias Manager for Linux.${RESET}

${BOLD}PENGGUNAAN:${RESET}
  jaaw [PERINTAH|OPSI] [-- [SCRCPY_OPTIONS...]]

${BOLD}KONEKSI & PAIRING:${RESET}
  ${GREEN}-p, --pair, pair${RESET}          Pairing via QR Code & auto-connect
  ${GREEN}-c, --connect, connect${RESET}    Koneksi cepat ke perangkat aktif via mDNS
  ${GREEN}-w, --wizard, wizard${RESET}      Buka menu interaktif (TUI wizard)
  ${GREEN}-u, --usb, usb${RESET}            Alihkan koneksi USB ke Wireless (port 5555)
  ${GREEN}-m, --manual, manual${RESET}      Pairing manual dengan IP:Port & 6-digit code

${BOLD}DEVICE ALIAS & SMART WRAPPER:${RESET}
  ${CYAN}devices${RESET}                   Tampilkan tabel perangkat & mapping alias
  ${CYAN}alias set <nama> [target]${RESET} Daftarkan atau perbarui alias perangkat
  ${CYAN}alias list${RESET}                Lihat daftar alias yang tersimpan
  ${CYAN}alias rm <nama>${RESET}           Hapus alias yang terdaftar
  ${CYAN}shell <alias> [args...]${RESET}   Buka ADB shell ke perangkat target
  ${CYAN}scrcpy <alias> [args...]${RESET}  Buka mirror screen ke perangkat target
  ${CYAN}use <alias>${RESET}               Set aktif target (export ANDROID_SERIAL)
  ${CYAN}exec <alias> <cmd...>${RESET}     Jalankan perintah ADB pada perangkat target
  ${CYAN}init [bash|zsh|fish]${RESET}      Inisialisasi smart wrapper shell adb

${BOLD}MIRRORING & STREAMING (scrcpy):${RESET}
  ${YELLOW}-s, --screen${RESET}              Auto-launch mirror screen setelah connect
  ${YELLOW}-b, --bitrate RATE${RESET}        Set bitrate video (misal: 2M, 4M, 8M)
  ${YELLOW}--screen-off, --off${RESET}       Matikan layar perangkat saat mirroring
  ${YELLOW}--scrcpy-args "ARGS"${RESET}      Kirim argumen custom ke scrcpy
  ${YELLOW}-- [SCRCPY_OPTIONS...]${RESET}    Oper argumen langsung ke scrcpy

${BOLD}DIAGNOSTIK & SISTEM:${RESET}
  ${BLUE}-d, --diag, diag${RESET}          Diagnostik Avahi/mDNS, firewall, & ADB
  ${BLUE}-r, --reset, reset${RESET}        Restart ADB server & reset koneksi
  ${BLUE}-l, --list, list${RESET}          Lihat riwayat perangkat tersimpan
  ${BLUE}-U, --update, update${RESET}      Periksa dan pasang pembaruan dari GitHub
  ${BLUE}-t, --timeout DETIK${RESET}       Set timeout deteksi mDNS (default: 60)
  ${BLUE}-v, --version${RESET}             Tampilkan informasi versi & pembuat
  ${BLUE}-h, --help${RESET}                Tampilkan panduan bantuan ini

${BOLD}CONTOH PENGGUNAAN:${RESET}
  jaaw -p                          # QR pairing & auto-connect
  jaaw -c -s                       # Connect ke Wi-Fi & langsung mirror layar
  jaaw alias set poco              # Buat alias 'poco' untuk HP
  jaaw devices                     # Cek status semua perangkat terhubung
  jaaw shell poco                  # Masuk ke shell HP poco
  eval "\$(jaaw init)"              # Aktifkan 'adb -s poco ...' transparan di shell
EOF
)"
}

main() {
    if [ $# -eq 0 ]; then
        show_quick_help
        return 0
    fi

    local action=""

    while [ $# -gt 0 ]; do
        case "$1" in
            update|--update|-U) action="update" ;;
            alias)
                shift
                flow_alias "$@"
                return 0
                ;;
            devices|--devices)
                flow_devices
                return 0
                ;;
            exec)
                shift
                flow_exec "$@"
                return 0
                ;;
            shell)
                shift
                flow_shell "$@"
                return 0
                ;;
            scrcpy)
                shift
                flow_scrcpy "$@"
                return 0
                ;;
            use)
                shift
                flow_use "$@"
                return 0
                ;;
            init)
                shift
                flow_init "$@"
                return 0
                ;;
            -w|--wizard|wizard)   action="wizard" ;;
            -p|--pair|pair)       action="pair" ;;
            -c|--connect|connect) action="connect" ;;
            -s|--screen)      LAUNCH_SCRCPY=true ;;
            -b|--bitrate)
                shift
                [ $# -gt 0 ] || die "Nilai bitrate harus ditentukan (contoh: -b 2M)."
                SCRCPY_BITRATE="$1"
                LAUNCH_SCRCPY=true
                ;;
            --screen-off|--off)
                SCRCPY_SCREEN_OFF=true
                LAUNCH_SCRCPY=true
                ;;
            --scrcpy-args)
                shift
                [ $# -gt 0 ] || die "Argumen scrcpy harus ditentukan (contoh: --scrcpy-args=\"-b 2M --turn-screen-off\")."
                eval "local parsed_args=($1)"
                SCRCPY_CUSTOM_ARGS+=("${parsed_args[@]}")
                LAUNCH_SCRCPY=true
                ;;
            --)
                shift
                SCRCPY_CUSTOM_ARGS+=("$@")
                LAUNCH_SCRCPY=true
                break
                ;;
            -u|--usb|usb)         action="usb" ;;
            -m|--manual|manual)   action="manual" ;;
            -l|--list|list)       action="list" ;;
            -d|--diag|diag)       action="diag" ;;
            -r|--reset|reset)     action="reset" ;;
            -t|--timeout)
                shift
                [ $# -gt 0 ] || die "Nilai timeout harus ditentukan (contoh: -t 60)."
                TIMEOUT="${1:-60}"
                ;;
            -v|--version)     show_version; return 0 ;;
            -h|--help)        usage; return 0 ;;
            *)                usage >&2; return 2 ;;
        esac
        shift
    done

    # Default action to 'pair' if an option like -s was given without explicit mode
    action="${action:-pair}"

    case "$action" in
        wizard)  flow_wizard_menu ;;
        pair)    flow_qr_pairing ;;
        connect) flow_quick_connect ;;
        usb)     flow_usb_to_wireless ;;
        manual)  flow_manual_pair ;;
        list)    flow_history ;;
        diag)    flow_diagnostics ;;
        reset)   flow_reset_adb ;;
        update)  flow_update ;;
    esac
}

# Allow sourcing for tests
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

